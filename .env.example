# Backend configuration
# Copy this file to .env in the repo root and adjust values as needed.

# Base URL of the LM Studio local server (OpenAI-compatible API)
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1

# Model identifier to request from LM Studio.
# Leave empty to auto-detect the first loaded model.
LM_STUDIO_MODEL=

# Path to the SQLite database file.
# Supports ~ for home directory expansion.
DB_PATH=~/.sloth_organizer/data.db
